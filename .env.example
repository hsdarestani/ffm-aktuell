DATABASE_URL=postgres://ffm:change_me@localhost:5432/ffm
SESSION_SECRET=generate-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# User media stays unavailable until independent ClamAV is reachable
CLAMD_HOST=
CLAMD_PORT=3310
# Optional server-side AI (only real verified venue IDs may be returned)
OPENAI_API_KEY=
OPENAI_RECOMMENDATION_MODEL=gpt-4o-mini

# Google OAuth confidential Web Client. Set redirect URI in Google Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Sign in with Apple: Services ID and signing key issued by Apple Developer.
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional verified-email delivery. No invitations or verification mail without both.
# Requires the sender domain to be verified by the mail provider.
RESEND_API_KEY=
FFM_EMAIL_FROM=


# Web Push: generate once with npx web-push generate-vapid-keys --json
# Keep the private key stable. Public key is intentionally returned to browsers.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:replace-with-real-operator@example.com
# Generate a separate random value with at least 32 characters.
PUSH_WORKER_TOKEN=

# Hosted web subscriptions. Register /api/billing/webhook in Stripe.
# Both are required; never activate a paid subscription from a success redirect.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
